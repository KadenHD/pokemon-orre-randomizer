* text=auto
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ico binary
*.png binary
# Interface metadata is hashed byte-for-byte alongside the images and audio.
# Preserve its exported bytes on Windows and Linux checkouts.
orre_randomizer/assets/game/** -text
# The validated music recipe pins these exact bytes, including line endings.
native/music/patches.json -text
native/music/renderer_adapter.c -text
# Preserve the upstream license texts copied with the HD artwork.
licenses/hd/** -text
