      "names": {
        "en": "Disarming Voice",
        "fr": "Voix Enjôleuse",
        "de": "Säuselstimme",
        "es": "Voz Cautivadora",
        "it": "Incantavoce",
        "ja": "チャームボイス"
      },
      "descriptions": {
        "en": "Letting out a charming cry, the user does emotional damage to opposing Pokémon. This attack never misses.",
        "fr": "Laisse s’échapper une voix enchanteresse qui inflige des dégâts psychiques à l’ennemi. Touche à coup sûr.",
        "de": "Der Anwender stößt einen bezirzenden Ruf aus, mit dem er gegnerische Pokémon in seinen Bann schlägt und ihnen mentalen Schaden zufügt. Trifft garantiert.",
        "es": "Obnubila a los oponentes con su fascinante voz y les provoca daños emocionales. Siempre acierta al objetivo.",
        "it": "Chi la usa infligge un danno spirituale ai nemici nei paraggi con una voce suadente. L’attacco andrà immancabilmente a segno.",
        "ja": "みわくの なきごえを だして あいてにせいしんてきな ダメージを あたえる。こうげきは かならず めいちゅう する。"
      }
    },
    "577": {
      "identifier": "draining-kiss",
      "is_new": true,
      "type": 18,
      "power": 50,
      "pp": 10,
      "accuracy": 100,
      "priority": 0,
      "target": "selected-pokemon",
      "damage_class": "special",
