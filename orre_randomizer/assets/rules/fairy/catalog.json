      "names": {
        "en": "Sweet Kiss",
        "fr": "Doux Baiser",
        "de": "Bitterkuss",
        "es": "Beso Dulce",
        "it": "Dolcebacio",
        "ja": "てんしのキッス"
      },
      "descriptions": {
        "en": "The user kisses the target with a sweet, angelic cuteness that causes confusion.",
        "fr": "Le lanceur envoie un bisou si mignon et désarmant qu’il plonge l’ennemi dans la confusion.",
        "de": "Anwender küsst das Ziel, das durch diese Niedlichkeit verwirrt wird.",
        "es": "Da un beso con tal dulzura que causa confusión.",
        "it": "Chi la usa bacia il bersaglio con una dolcezza angelica, confondendolo.",
        "ja": "てんしのように かわいく キスしてあいてを こんらん させる。"
      }
    },
    "204": {
