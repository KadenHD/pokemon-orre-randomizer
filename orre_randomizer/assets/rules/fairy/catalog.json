      "names": {
        "en": "Charm",
        "fr": "Charme",
        "de": "Charme",
        "es": "Encanto",
        "it": "Fascino",
        "ja": "あまえる"
      },
      "descriptions": {
        "en": "The user gazes at the target rather charmingly, making it less wary. This harshly lowers the target’s Attack stat.",
        "fr": "Le lanceur fait les yeux doux pour berner l’ennemi et beaucoup réduire son Attaque.",
        "de": "Betört das Ziel und reduziert dessen Angriffs-Wert stark.",
        "es": "Engatusa al objetivo y reduce mucho su Ataque.",
        "it": "Ammalia il bersaglio con lo sguardo per renderlo meno cauto. Ne riduce molto l’Attacco.",
        "ja": "かわいく みつめて ゆだんを さそいあいての こうげきを がくっと さげる。"
      }
    },
    "236": {
      "identifier": "moonlight",
