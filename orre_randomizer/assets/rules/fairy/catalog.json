      "names": {
        "en": "Moonlight",
        "fr": "Rayon Lune",
        "de": "Mondschein",
        "es": "Luz Lunar",
        "it": "Lucelunare",
        "ja": "つきのひかり"
      },
      "descriptions": {
        "en": "The user restores its own HP. The amount of HP regained varies with the weather.",
        "fr": "Un soin qui restaure des PV au lanceur. Son efficacité varie en fonction de la météo.",
        "de": "Füllt KP des Anwenders auf. Die Menge hängt vom Wetter ab.",
        "es": "Restaura PS del usuario. La cantidad varía según el tiempo que haga.",
        "it": "Chi la usa recupera PS. Il numero di PS recuperati dipende dalle condizioni atmosferiche.",
        "ja": "じぶんの ＨＰを かいふく する。てんきに よってかいふくの りょうが へんか する。"
      }
    },
    "574": {
      "identifier": "disarming-voice",
      "is_new": true,
      "type": 18,
      "power": 40,
