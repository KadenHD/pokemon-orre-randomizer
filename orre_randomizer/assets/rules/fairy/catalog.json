      "stat_changes": [],
      "names": {
        "en": "Draining Kiss",
        "fr": "Vampibaiser",
        "de": "Diebeskuss",
        "es": "Beso Drenaje",
        "it": "Assorbibacio",
        "ja": "ドレインキッス"
      },
      "descriptions": {
        "en": "The user steals the target’s HP with a kiss. The user’s HP is restored by over half of the damage taken by the target.",
        "fr": "Aspire la force vitale de l’ennemi par un baiser. Rend au lanceur un nombre de PV supérieur ou égal à la moitié des dégâts infligés.",
        "de": "Der Anwender stiehlt dem Ziel mit einem Kuss KP. Die Höhe der Heilung beträgt mehr als die Hälfte des beim Ziel angerichteten Schadens.",
        "es": "El usuario absorbe PS del objetivo con un beso y restaura su propia energía en una cantidad igual o superior a la mitad del daño infligido.",
        "it": "Chi la usa assorbe energia dal bersaglio con un bacio, recuperando così PS in quantità pari a più della metà del danno inferto.",
        "ja": "キッスによって あいてから ＨＰをすいとる。 あたえた ダメージのはんぶんいじょう ＨＰを かいふくする。"
      }
    },
