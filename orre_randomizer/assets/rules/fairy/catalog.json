      "names": {
        "en": "Play Rough",
        "fr": "Câlinerie",
        "de": "Knuddler",
        "es": "Carantoña",
        "it": "Carineria",
        "ja": "じゃれつく"
      },
      "descriptions": {
        "en": "The user plays rough with the target and attacks it. This may also lower the target’s Attack stat.",
        "fr": "Attaque l’ennemi avec un câlin. Peut diminuer son Attaque.",
        "de": "Der Anwender knuddelt das Ziel und greift es an. Senkt eventuell den Angriffs-Wert des Zieles.",
        "es": "El Pokémon que lo usa le hace cucamonas al objetivo y lo ataca. Puede disminuir el Ataque del objetivo.",
        "it": "Chi la usa attacca il bersaglio con delle carinerie. Può anche ridurne l’Attacco.",
        "ja": "あいてに じゃれついてこうげきする。 あいてのこうげきを さげる ことがある。"
      }
    },
